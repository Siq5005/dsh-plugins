{
  "version": 1,
  "plugins": [
    {
      "name": "dsh-hello-plugin",
      "description": "示例插件：验证安装链路的最小模板",
      "type": "bundle",
      "path": "bundles/hello-plugin",
      "install": "dsh plugin --profile <name> add \"Siq5005/dsh-plugins#path:/bundles/hello-plugin\"",
      "tags": ["example", "template"],
      "added": "2026-08-17"
    },
    {
      "name": "dsh-dafeiyu-mac",
      "description": "macOS 桌面大肥鱼：由 DSH 会话状态驱动的桌宠伴侣（复刻自 dsh-dafeiyu）",
      "type": "bundle",
      "path": "bundles/dsh-dafeiyu-mac",
      "install": "dsh plugin --profile <name> add \"Siq5005/dsh-plugins#path:/bundles/dsh-dafeiyu-mac\"",
      "tags": ["desktop-pet", "companion", "macos", "pyside6", "replica"],
      "added": "2026-08-17"
    },
    {
      "name": "dsh-deepseek-cost",
      "description": "按 DeepSeek 官方定价统计当前对话的 token 用量与累计费用（未缓存输入 / 缓存输入 / 输出，分高峰空闲时段计价）",
      "type": "bundle",
      "path": "bundles/dsh-deepseek-cost",
      "install": "dsh plugin --profile <name> add \"Siq5005/dsh-plugins#path:/bundles/dsh-deepseek-cost\"",
      "tags": ["token-usage", "cost-tracking", "pricing", "deepseek"],
      "added": "2026-08-17"
    },
    {
      "name": "dsh-vision-adapter",
      "description": "给 DeepSeek 主模型加\"眼睛\"：stealth 式接管 deepseek-official 路由，adapter 层把图片改写为文本，analyze_image 工具按需调用 OpenAI 兼容多模态端点（内容哈希缓存，可选自动描述）",
      "type": "bundle",
      "path": "bundles/dsh-vision-adapter",
      "install": "dsh plugin --profile <name> add \"Siq5005/dsh-plugins#path:/bundles/dsh-vision-adapter\"",
      "tags": ["vision", "multimodal", "image", "deepseek", "image-analysis"],
      "added": "2026-08-17"
    }
  ]
}
