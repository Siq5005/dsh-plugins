{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Siq5005/dsh-plugins/blob/main/plugins.schema.json",
  "title": "dsh-plugins 索引格式",
  "type": "object",
  "required": ["version", "plugins"],
  "properties": {
    "version": {
      "type": "integer",
      "description": "索引格式版本号，格式变更时递增"
    },
    "plugins": {
      "type": "array",
      "description": "插件条目列表，新增插件必须追加",
      "items": {
        "type": "object",
        "required": ["name", "description", "type", "install"],
        "properties": {
          "name": {
            "type": "string",
            "description": "插件包名（package.json 的 name 字段）"
          },
          "description": {
            "type": "string",
            "description": "一句话简介，用于搜寻"
          },
          "type": {
            "enum": ["bundle", "skill", "tool", "mcp"],
            "description": "插件类型"
          },
          "path": {
            "type": "string",
            "description": "仓库内相对路径，如 bundles/hello-plugin；外部安装的包（设置了 repo）可省略"
          },
          "install": {
            "type": "string",
            "description": "安装命令（<name> 为 profile 占位符）"
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "可选：搜索标签"
          },
          "added": {
            "type": "string",
            "format": "date",
            "description": "可选：加入日期 YYYY-MM-DD"
          },
          "repo": {
            "type": "string",
            "description": "可选：独立仓库 URL（方案 C 拆分后填写）"
          }
        }
      }
    }
  }
}
